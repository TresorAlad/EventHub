EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api

EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_mobile_app_id

EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# Optionnel — Sentry (@sentry/react-native). Sans DSN, l’initialisation est ignorée.
# EXPO_PUBLIC_SENTRY_DSN=https://...@...@.ingest.sentry.io/...

# Optionnel — tunnel Expo / ngrok (évite souvent « took too long »)
# Obtenir un token : https://dashboard.ngrok.com → puis : ngrok config add-authtoken <token>
# Ou avant npm start : $env:NGROK_AUTHTOKEN="..."   (PowerShell)
# NGROK_AUTHTOKEN=
