{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "postinstall": "node scripts/patch-expo-tunnel-timeout.js",
    "start": "node scripts/patch-expo-tunnel-timeout.js && node scripts/print-expo-go-url.js tunnel && npx expo start --go --tunnel",
    "start:clear": "node scripts/patch-expo-tunnel-timeout.js && node scripts/print-expo-go-url.js tunnel && npx expo start --go --tunnel --clear",
    "start:lan": "node scripts/patch-expo-tunnel-timeout.js && node scripts/print-expo-go-url.js lan && npx expo start --go --lan",
    "start:lan:clear": "node scripts/patch-expo-tunnel-timeout.js && node scripts/print-expo-go-url.js lan && npx expo start --go --lan --clear",
    "start:dev-client": "node scripts/patch-expo-tunnel-timeout.js && npx expo start --dev-client --tunnel",
    "update:dev": "npx eas-cli update --branch development --message \"dev update\"",
    "update:prod": "npx eas-cli update --branch production --message \"prod update\"",
    "build:apk": "npx eas-cli build --platform android --profile apk",
    "build:apk:preview": "npx eas-cli build --platform android --profile preview",
    "android": "npx expo run:android",
    "android:open": "node scripts/open-expo-go-android.js",
    "android:reverse": "adb reverse tcp:8081 tcp:8081",
    "ios": "npx expo run:ios",
    "web": "npx expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.10",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.12",
    "@react-navigation/stack": "^7.8.11",
    "@sentry/react-native": "~7.2.0",
    "@tanstack/query-async-storage-persister": "^5.100.9",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-query-persist-client": "^5.100.9",
    "axios": "^1.15.2",
    "axios-retry": "^4.5.0",
    "expo": "~54.0.34",
    "expo-auth-session": "~7.0.11",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-notifications": "~0.32.17",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.17",
    "expo-web-browser": "~15.0.11",
    "firebase": "^12.12.1",
    "lucide-react-native": "^1.14.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.4",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~54.0.10",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
